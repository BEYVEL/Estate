<script>
  document.documentElement.classList.add('js');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const me = document.getElementById('me');
  const tagsEl = document.getElementById('tags');
  const reveals = [...document.querySelectorAll('.reveal')];
  let typingTimer = null;

  // Simple parser so the demo reacts to what the visitor types.
  function parse(text) {
    const t = text.toLowerCase(), out = [];
    const rooms = t.match(/(\d+)\s*(?:-?\s*к|комн)/) || t.match(/(студи)/);
    if (rooms) out.push(rooms[1] === 'студи' ? 'Студия' : rooms[1] + ' комн.');
    const budget = t.match(/(?:до|не дороже)\s*(\d+(?:[.,]\d+)?)\s*(?:млн|миллион)/);
    if (budget) out.push('До ' + budget[1].replace(',', '.') + ' млн ₽');
    if (/центр/.test(t)) out.push('Центр Москвы');
    if (/метро/.test(t)) out.push('У метро');
    if (/(детск\w* сад|садик)/.test(t)) out.push('Рядом детский сад');
    if (/школ/.test(t)) out.push('Рядом школа');
    return out;
  }

  function renderTags(text, animate) {
    const found = parse(text);
    tagsEl.replaceChildren();
    const make = (label, cls) => { const s = document.createElement('span'); s.className = cls; s.textContent = label; return s; };
    if (!found.length) { tagsEl.append(make('Добавьте район, комнаты или бюджет', 'tag empty')); return; }
    found.forEach((label, i) => {
      const s = make(label, 'tag');
      if (animate && !reduce) { s.style.opacity = 0; setTimeout(() => { s.style.transition = 'opacity .3s'; s.style.opacity = 1; }, 120 * i); }
      tagsEl.append(s);
    });
  }

  function showResults(on) { reveals.forEach((el, i) => setTimeout(() => el.classList.toggle('in', on), on && !reduce ? 160 * i : 0)); }

  function say(text, animate) {
    clearTimeout(typingTimer);
    me.textContent = '';
    tagsEl.replaceChildren();
    showResults(false);
    if (!animate || reduce) { me.textContent = text; renderTags(text, false); showResults(true); return; }
    let i = 0;
    (function step() {
      me.textContent = text.slice(0, ++i);
      if (i < text.length) typingTimer = setTimeout(step, 22);
      else { renderTags(text, true); setTimeout(() => showResults(true), 350); }
    })();
  }

  const initial = 'Квартира 3 комнаты рядом с детским садом, в центре Москвы, не дороже 40 миллионов';
  // Play the demo once when it scrolls into view.
  let played = false;
  const demo = document.getElementById('demo');
  if ('IntersectionObserver' in window) {
    new IntersectionObserver((es, o) => { if (es[0].isIntersecting && !played) { played = true; say(initial, true); o.disconnect(); } }, { threshold: .35 }).observe(demo);
  } else { played = true; say(initial, false); }

  function ask(text) { played = true; document.getElementById('demo').scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' }); setTimeout(() => say(text, true), reduce ? 0 : 450); }

  [['ask-form', 'ask'], ['ask-form-2', 'ask2']].forEach(([f, i]) => {
    document.getElementById(f).addEventListener('submit', e => { e.preventDefault(); const v = document.getElementById(i).value.trim(); if (v) ask(v); });
  });
  document.getElementById('chips').addEventListener('click', e => {
    const c = e.target.closest('.chip'); if (!c) return;
    document.getElementById('ask').value = c.textContent; ask(c.textContent);
  });

  document.querySelectorAll('.heart').forEach(b => b.addEventListener('click', () => {
    const on = b.getAttribute('aria-pressed') !== 'true';
    b.setAttribute('aria-pressed', on);
    const l = b.getAttribute('aria-label');
    b.setAttribute('aria-label', on ? l.replace('Добавить', 'Убрать').replace(' в избранное', ' из избранного') : l.replace('Убрать', 'Добавить').replace(' из избранного', ' в избранное'));
  }));
</script>

