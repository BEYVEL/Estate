<!DOCTYPE html>

<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Nexus Home: ИИ-ассистент по подбору недвижимости</title>
<meta name="description" content="Опишите дом мечты обычными словами. Nexus Home подберёт варианты, объяснит выбор и покажет всё рядом на карте.">
<style>
  :root {
    --brand: #8c1515;
    --brand-hi: #a51c1c;
    --wine: #3a0a0e;
    --bg: #ffffff;
    --mist: #f5f1f1;
    --ink: #1d1214;
    --muted: #6a5a5c;
    --line: #e8dfdf;
    --focus: #1a5fd0;
    --r-lg: 32px;
    --r-md: 22px;
    --font: "Inter Tight", "Manrope", "Inter", "Segoe UI", Roboto, "Helvetica Neue", Arial, system-ui, sans-serif;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #140c0d;
      --mist: #221617;
      --ink: #f6eded;
      --muted: #bda3a5;
      --line: #36292a;
      --focus: #8ab4ff;
      color-scheme: dark;
    }
  }

- { box-sizing: border-box; }
  html { scroll-behavior: smooth; scroll-padding-top: 96px; }
  body {
  margin: 0; font-family: var(–font); font-size: 18px; line-height: 1.55;
  background: var(–bg); color: var(–ink); -webkit-font-smoothing: antialiased;
  }
  svg { display: block; max-width: 100%; }
  a { color: inherit; }
  h1, h2, h3, p { margin: 0; }
  :focus-visible { outline: 3px solid var(–focus); outline-offset: 3px; border-radius: 8px; }
  .wrap { width: min(1240px, 100% - 2 * clamp(16px, 3vw, 40px)); margin-inline: auto; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

/* ––––– Buttons ––––– */
.btn {
display: inline-flex; align-items: center; justify-content: center; gap: 8px;
min-height: 52px; padding: 0 28px; border-radius: 999px; border: 0; cursor: pointer;
font: 650 17px var(–font); text-decoration: none; transition: background .15s, color .15s;
}
.btn-brand { background: var(–brand); color: #fff; }
.btn-brand:hover { background: var(–wine); }
.btn-white { background: #fff; color: var(–brand); }
.btn-white:hover { background: #f6e6e6; }
.btn-sm { min-height: 44px; padding: 0 20px; font-size: 15px; }

/* ––––– Floating nav ––––– */
.top { position: sticky; top: 12px; z-index: 30; padding-top: 12px; }
.pill {
display: flex; align-items: center; gap: 16px; min-height: 64px; padding: 8px 10px 8px 22px;
background: color-mix(in srgb, var(–bg) 94%, transparent); backdrop-filter: blur(14px);
-webkit-backdrop-filter: blur(14px); border: 1px solid var(–line); border-radius: 999px;
box-shadow: 0 10px 30px -18px rgba(58,10,14,.35);
}
.brand { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; font-weight: 750; font-size: 19px; letter-spacing: -.02em; color: var(–brand); }
.brand svg { width: 34px; height: 34px; }
@media (prefers-color-scheme: dark) { .brand { color: #f2bcbc; } }
.pill nav { margin-inline: auto; }
.pill ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 2px; }
.pill nav a { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 16px; border-radius: 999px; text-decoration: none; font-size: 15px; font-weight: 600; color: var(–ink); }
.pill nav a:hover { background: var(–mist); }
.pill nav svg { width: 19px; height: 19px; color: var(–brand); }
@media (prefers-color-scheme: dark) { .pill nav svg { color: #f2bcbc; } }
.lang { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; padding: 0 14px; border: 0; border-radius: 999px; background: none; color: var(–ink); font: 600 15px var(–font); cursor: pointer; }
.lang:hover { background: var(–mist); }
.lang svg { width: 18px; height: 18px; }

/* ––––– Hero ––––– */
.hero {
position: relative; overflow: hidden; background: var(–brand); color: #fff;
width: min(1320px, 100% - 24px); margin: -76px auto 0; padding-top: 76px; border-radius: var(–r-lg);
}
.hero-grid {
position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr);
gap: clamp(24px, 4vw, 64px); align-items: center;
padding: clamp(48px, 7vw, 96px) clamp(24px, 5vw, 80px) clamp(56px, 7vw, 104px);
}
.hero h1 { font-size: clamp(2.3rem, 4.5vw, 4rem); line-height: 1.04; letter-spacing: -.03em; font-weight: 750; text-wrap: balance; }
.hero .lead { margin-top: 22px; max-width: 31em; font-size: clamp(1.05rem, 1.5vw, 1.2rem); color: rgba(255,255,255,.86); }
.ask { margin-top: 34px; max-width: 580px; }
.ask-field { display: flex; align-items: center; gap: 6px; background: #fff; color: #3a0b0b; border-radius: 999px; padding: 6px 6px 6px 24px; box-shadow: 0 22px 44px -24px rgba(0,0,0,.6); }
.ask-field:focus-within { outline: 3px solid #fff; outline-offset: 3px; }
.ask-field input { flex: 1; min-width: 0; min-height: 52px; border: 0; outline: 0; background: none; font: 500 18px var(–font); color: #3a0b0b; }
.ask-field input::placeholder { color: #8c1515; opacity: .78; }
.chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; }
.chip { min-height: 40px; padding: 0 16px; border-radius: 999px; border: 1px solid rgba(255,255,255,.4); background: transparent; color: #fff; font: 600 15px var(–font); cursor: pointer; }
.chip:hover { background: rgba(255,255,255,.14); }

.orbit { position: relative; width: min(100%, 460px); aspect-ratio: 1; justify-self: center; }
.orbit-lines { position: absolute; max-width: none; width: 230%; left: -65%; top: -65%; aspect-ratio: 1; pointer-events: none; }
.ring { position: absolute; inset: 0; }
.ring svg { width: 100%; height: 100%; animation: spin 70s linear infinite; }
.ring text { fill: #fff; font: 600 32px var(–font); }
.seal { position: absolute; inset: 50% auto auto 50%; transform: translate(-50%, -50%); width: 25%; aspect-ratio: 1; border-radius: 50%; background: #fff; color: var(–brand); display: grid; place-items: center; box-shadow: 0 0 0 10px rgba(255,255,255,.16), 0 0 0 22px rgba(255,255,255,.08); }
.seal svg { width: 62%; height: 62%; }
.node { position: absolute; display: inline-flex; align-items: center; min-height: 36px; padding: 0 14px; border-radius: 999px; background: #fff; color: var(–brand); font-size: 14px; font-weight: 700; white-space: nowrap; box-shadow: 0 14px 30px -14px rgba(0,0,0,.55); }
.node.n1 { left: -2%; top: 2%; }
.node.n2 { right: -2%; bottom: 0; }
.node.n3 { left: -2%; bottom: -5%; }
@keyframes spin { to { transform: rotate(360deg); } }

/* ––––– Section scaffolding ––––– */
section { padding-block: clamp(72px, 10vw, 128px); }
h2 { font-size: clamp(1.9rem, 3.6vw, 3rem); line-height: 1.07; letter-spacing: -.028em; font-weight: 750; text-wrap: balance; max-width: 17em; }
.sub { margin-top: 16px; max-width: 34em; color: var(–muted); font-size: 1.1rem; }
.head-center { text-align: center; }
.head-center h2, .head-center .sub { margin-inline: auto; }

/* ––––– Product window ––––– */
.stagebox { background: var(–wine); border-radius: var(–r-lg); padding: clamp(14px, 3vw, 40px); width: min(1320px, 100% - 24px); margin-inline: auto; margin-top: clamp(40px, 5vw, 64px); }
.window { background: var(–bg); border-radius: var(–r-md); overflow: hidden; box-shadow: 0 40px 80px -40px rgba(0,0,0,.7); }
.wbar { display: flex; align-items: center; gap: 12px; padding: 8px 18px; background: var(–mist); border-bottom: 1px solid var(–line); }
.wbar .brand { font-size: 15px; }
.wbar .brand svg { width: 28px; height: 28px; }
.wbar .icons { margin-inline: auto; display: flex; gap: 6px; color: var(–brand); }
@media (prefers-color-scheme: dark) { .wbar .icons { color: #f2bcbc; } }
.wbar .icons span { width: 40px; height: 40px; display: grid; place-items: center; }
.wbar .icons svg { width: 19px; height: 19px; }
.wbody { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); min-height: 520px; }
.chat { padding: clamp(20px, 3vw, 36px); display: flex; flex-direction: column; gap: 14px; border-right: 1px solid var(–line); }
.bubble { max-width: 92%; font-size: 16px; line-height: 1.45; }
.bubble.bot { color: var(–brand); font-weight: 650; }
@media (prefers-color-scheme: dark) { .bubble.bot { color: #f2bcbc; } }
.bubble.me { align-self: flex-end; background: var(–mist); padding: 11px 16px; border-radius: 18px 18px 4px 18px; min-height: 48px; }
.tags { display: flex; flex-wrap: wrap; gap: 8px; min-height: 34px; }
.tag { display: inline-flex; align-items: center; min-height: 32px; padding: 0 12px; border-radius: 8px; background: var(–brand); color: #fff; font-size: 14px; font-weight: 650; }
.tag.empty { background: transparent; color: var(–muted); border: 1px dashed var(–line); font-weight: 600; }
.status { font-size: 15px; color: var(–muted); }
.compose { margin-top: auto; display: flex; align-items: center; gap: 8px; border: 1px solid var(–line); border-radius: 999px; padding: 6px 8px 6px 18px; color: var(–muted); font-size: 15px; }
.compose svg { width: 18px; height: 18px; margin-left: auto; color: var(–brand); }
.list { padding: clamp(16px, 2.4vw, 28px); display: flex; flex-direction: column; gap: 14px; }
.row { display: grid; grid-template-columns: 168px minmax(0, 1fr); gap: 18px; padding: 12px; border: 1px solid var(–line); border-radius: 18px; align-items: stretch; }
.row.first { border-color: var(–brand); }
.row .ph { position: relative; border-radius: 12px; overflow: hidden; min-height: 120px; }
.row .ph svg { width: 100%; height: 100%; }
.row h3 { font-size: 1.1rem; line-height: 1.25; letter-spacing: -.01em; }
.row .meta { font-size: .95rem; color: var(–muted); margin-top: 2px; }
.row .price { font-size: 1.3rem; font-weight: 750; letter-spacing: -.015em; margin-top: 8px; }
.match { list-style: none; margin: 10px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
.match li { display: inline-flex; align-items: center; gap: 6px; min-height: 28px; padding: 0 10px; border-radius: 999px; font-size: 13px; font-weight: 600; background: var(–mist); }
.match svg { width: 14px; height: 14px; }
.match .ok svg { color: #1f7a45; }
.match .no { color: var(–muted); }
.match .no svg { color: var(–muted); }
.heart { position: absolute; top: 8px; right: 8px; width: 40px; height: 40px; border-radius: 50%; border: 0; background: rgba(255,255,255,.94); color: var(–brand); display: grid; place-items: center; cursor: pointer; }
.heart svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2; }
.heart[aria-pressed=“true”] svg { fill: currentColor; }
.demo-note { margin-top: 18px; text-align: center; font-size: .9rem; color: rgba(255,255,255,.62); }

/* reveal for the demo: a single orchestrated moment */
.js .reveal { opacity: 0; transform: translateY(10px); transition: opacity .5s ease, transform .5s ease; }
.js .reveal.in { opacity: 1; transform: none; }

/* ––––– Bento ––––– */
.bento { margin-top: clamp(36px, 5vw, 64px); display: grid; grid-template-columns: repeat(12, 1fr); gap: 16px; }
.tile { border-radius: var(–r-md); padding: clamp(22px, 2.6vw, 34px); display: flex; flex-direction: column; gap: 10px; min-height: 300px; position: relative; overflow: hidden; }
.tile h3 { font-size: 1.35rem; line-height: 1.2; letter-spacing: -.02em; font-weight: 700; }
.tile p { color: inherit; opacity: .78; font-size: 1rem; max-width: 26em; }
.t-a { grid-column: span 7; background: var(–mist); }
.t-b { grid-column: span 5; background: var(–brand); color: #fff; }
.t-c { grid-column: span 4; background: var(–bg); border: 1px solid var(–line); }
.t-d { grid-column: span 4; background: var(–wine); color: #fff; }
.t-e { grid-column: span 4; background: var(–mist); }
.say { margin-top: auto; align-self: flex-start; background: var(–bg); border-radius: 20px 20px 20px 4px; padding: 14px 18px; font-size: 1.05rem; font-weight: 550; max-width: 30em; box-shadow: 0 16px 30px -22px rgba(58,10,14,.5); }
.say + .tags { margin-top: 12px; }
.reasons { margin: auto 0 0; padding: 0; list-style: none; display: grid; gap: 10px; }
.reasons li { display: flex; gap: 10px; align-items: center; background: rgba(255,255,255,.12); border-radius: 12px; padding: 10px 14px; font-size: .98rem; font-weight: 550; }
.reasons svg { width: 18px; height: 18px; flex: none; }
.map { margin: auto -34px -34px; }
.map svg { width: 100%; height: auto; }
.favs { margin-top: auto; display: flex; gap: 10px; }
.fav { flex: 1; aspect-ratio: 1; border-radius: 14px; overflow: hidden; position: relative; }
.fav svg.pic { width: 100%; height: 100%; }
.fav .h { position: absolute; right: 6px; top: 6px; width: 26px; height: 26px; border-radius: 50%; background: #fff; color: var(–brand); display: grid; place-items: center; }
.fav .h svg { width: 14px; height: 14px; fill: currentColor; }
.asks { margin-top: auto; display: flex; flex-wrap: wrap; gap: 8px; }
.asks span { display: inline-flex; align-items: center; min-height: 38px; padding: 0 16px; border-radius: 999px; background: var(–bg); font-size: 15px; font-weight: 600; box-shadow: 0 10px 22px -16px rgba(58,10,14,.5); }

/* ––––– Steps ––––– */
.steps { margin: clamp(40px, 5vw, 72px) 0 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(20px, 4vw, 56px); position: relative; }
.steps::before { content: “”; position: absolute; left: 14px; right: 14px; top: 14px; height: 2px; background: var(–line); }
.steps li { position: relative; padding-top: 52px; }
.steps li::before { content: “”; position: absolute; top: 4px; left: 0; width: 22px; height: 22px; border-radius: 50%; background: var(–bg); border: 3px solid var(–brand); }
.steps h3 { font-size: 1.3rem; letter-spacing: -.015em; margin-bottom: 8px; }
.steps p { color: var(–muted); font-size: 1rem; max-width: 24em; }

/* ––––– CTA ––––– */
.cta-panel { position: relative; overflow: hidden; background: var(–brand); color: #fff; border-radius: var(–r-lg); width: min(1320px, 100% - 24px); margin-inline: auto; padding: clamp(48px, 8vw, 112px) clamp(24px, 5vw, 80px); text-align: center; }
.cta-panel svg.bg { position: absolute; left: 50%; top: 50%; width: 150%; max-width: none; transform: translate(-50%, -50%); pointer-events: none; }
.cta-panel > *:not(.bg) { position: relative; }
.cta-panel h2 { margin-inline: auto; }
.cta-panel p { margin: 16px auto 32px; max-width: 30em; color: rgba(255,255,255,.84); }
.cta-panel .ask { margin-inline: auto; text-align: left; }
.cta-section { padding-top: 0; }

footer { padding-block: 40px 48px; font-size: .95rem; color: var(–muted); }
footer .wrap { display: flex; flex-wrap: wrap; gap: 16px 32px; align-items: center; justify-content: space-between; border-top: 1px solid var(–line); padding-top: 32px; }
footer ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 24px; flex-wrap: wrap; }
footer a { text-decoration: none; }
footer a:hover { text-decoration: underline; }

/* ––––– Responsive ––––– */
@media (max-width: 1000px) {
.hero-grid { grid-template-columns: minmax(0, 1fr); }
.orbit { width: min(78vw, 420px); margin: 12px auto 0; }
.wbody { grid-template-columns: minmax(0, 1fr); }
.chat { border-right: 0; border-bottom: 1px solid var(–line); }
.t-a, .t-b { grid-column: span 12; }
.t-c, .t-d, .t-e { grid-column: span 6; }
.t-e { grid-column: span 12; }
.pill nav a span { display: none; }
.pill nav a { padding: 0 12px; }
}
@media (max-width: 640px) {
body { font-size: 17px; }
.pill { padding-left: 16px; gap: 8px; }
.brand span { display: none; }
.pill .btn { display: none; }
.lang { margin-left: auto; }
.ask-field { padding-left: 18px; }
.ask-field .btn { padding: 0 18px; }
.node { display: none; }
.row { grid-template-columns: minmax(0, 1fr); }
.row .ph { min-height: 0; aspect-ratio: 16 / 10; }
.t-c, .t-d { grid-column: span 12; }
.tile { min-height: 260px; }
.steps { grid-template-columns: minmax(0, 1fr); gap: 32px; }
.steps::before { left: 10px; right: auto; top: 10px; bottom: 10px; width: 2px; height: auto; }
.steps li { padding: 0 0 0 44px; }
.steps li::before { top: 0; }
}
@media (prefers-reduced-motion: reduce) {
.ring svg { animation: none; }
html { scroll-behavior: auto; }
.btn, .js .reveal { transition: none; }
}
</style>

</head>
